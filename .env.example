VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Base checkout URL on the BGrowth Website. The Buy Now button appends
# ?product=<slug> to this — e.g. https://bgrowthclub.com/checkout becomes
# https://bgrowthclub.com/checkout?product=notary-appointment-workspace.
# Buy Now shows an error instead of navigating until this is set (see
# src/services/checkoutService.ts).
VITE_CHECKOUT_URL=

# Superseded — no longer read anywhere. Each Workspace now gets its own
# auto-generated Welcome PDF at publish time (products.welcome_pdf_url, see
# api/_lib/generateWelcomePdf.ts) instead of one shared static guide. Left
# here, unused, rather than deleted — see CLAUDE.md-equivalent convention
# of not removing things without explicit approval.
VITE_WELCOME_GUIDE_URL=

# Publishing Engine API routes only (api/publishing-engine/*) — server-side,
# never exposed to the browser. Do NOT prefix these with VITE_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
PUBLISHING_ENGINE_SECRET=a-long-random-shared-secret

# Notification emails (api/notifications/*, api/_lib/email/) — server-side
# only. RESEND_API_KEY comes from the Resend dashboard. RESEND_FROM_EMAIL
# must be an address on a domain verified in Resend — sends from an
# unverified domain are rejected, and Resend's own sandbox address
# (onboarding@resend.dev) can only send to the account owner's own email,
# not real members. PORTAL_PUBLIC_URL is the live Portal domain, used to
# build the logo image and "Open Workspace" link inside email bodies —
# without it those emails just omit the logo/link rather than send a
# broken relative URL.
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM_EMAIL=BGrowth <notifications@your-verified-domain.com>
PORTAL_PUBLIC_URL=https://your-portal-domain.com
